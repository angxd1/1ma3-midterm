# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# Both values are from Supabase → Project Settings → API. The anon key is a publishable key (RLS protects data).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: where magic links land (defaults to https://1ma3-midterm.vercel.app; localhost always stays local).
# VITE_SITE_URL=https://1ma3-midterm.vercel.app
